# Supabase ダッシュボード → Project Settings → API Keys / Data API からコピーしてください。
# このファイルを .env.local という名前でコピーして値を入れます（.env.local は Git に含めない）。

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Publishable key（sb_publishable_... で始まるキー）。
# 古いプロジェクトで publishable key が無い場合は anon key を入れても動きます。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# 食事写真の AI 解析（任意）。サーバーだけで使う値なので NEXT_PUBLIC_ を付けないこと。
# Claude Console（https://console.anthropic.com/）の API Keys で作成します。未設定でも手入力・検索・提案は使えます。
ANTHROPIC_API_KEY=
# 任意: 解析に使うモデル（省略時は claude-sonnet-5-5）
# MEAL_ANALYSIS_MODEL=claude-sonnet-5-5
